# Copia este archivo como backend/.env.local y rellena los valores. .env.local NO se sube a git.
# Lo usan los scripts de ingesta del backend. NUNCA copies estas claves a frontend/.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secret (sb_secret_...): da acceso total y se salta la seguridad por filas (RLS).
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# --- NASA ---
NASA_API_KEY=DEMO_KEY
