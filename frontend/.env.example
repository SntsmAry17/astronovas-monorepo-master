# Copy this file as frontend/.env.local only if you need overrides.
# The app runs with ZERO environment variables:
#   - Scientific site data ships as bundled JSON (src/data/sites/*.json)
#   - NASA POWER needs no API key and is queried live by /api/climate
#
# Optional — api.nasa.gov key if future endpoints need it (https://api.nasa.gov):
# NASA_API_KEY=DEMO_KEY
